{
  "name": "hmt-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "HMT - Hackathon Management Tool Monorepo - Foundation",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --dir apps/participant-api/frontend run dev",
    "dev:backend": "concurrently -k -n participant,organizer -c blue,green \"pnpm --dir apps/participant-api run dev\" \"pnpm --filter @hmt/organizer-api run dev\"",
    "build": "pnpm -r build",
    "build:apps": "pnpm --filter \"@hmt/*-api\" build",
    "build:packages": "pnpm --filter \"@hmt/*\" --filter \"!@hmt/*-api\" build",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down -v",
    "docker:validate": "docker-compose -f infra/docker/docker-compose.yml config",
    "prisma:generate": "pnpm --filter @hmt/database prisma:generate",
    "prisma:migrate": "pnpm --filter @hmt/database prisma:migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "fastify": "4.29.1"
  }
}
