# HMT Frontend — copy to .env and fill for local dev.
# Production (Vercel or equivalent static hosting): set these in the platform env dashboard.
# Never commit real URLs with credentials; never hard-code production domains in code.
# Canonical dev: participant :3000, organizer :3002, frontend :5173 (:3001 legacy, do not use).
VITE_API_URL=http://localhost:3000/api/v1
VITE_ORGANIZER_API_URL=http://localhost:3002/api/v1
# Demo/fake data is OFF by default. Set true only for local UI demos.
VITE_DEMO_MODE=false
VITE_API_TIMEOUT_MS=15000
