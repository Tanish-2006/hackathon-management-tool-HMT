{
  "name": "@hmt/organizer-api",
  "version": "0.1.0",
  "private": true,
  "description": "HMT Organizer Backend - Hackathon Management, Mentor System, Publishing",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --coverage=false",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "dev": "tsx --env-file=../../.env src/main.ts"
  },
  "dependencies": {
    "@hmt/ai": "workspace:*",
    "@hmt/common": "workspace:*",
    "@hmt/config": "workspace:*",
    "@hmt/contracts": "workspace:*",
    "@hmt/database": "workspace:*",
    "@hmt/observability": "workspace:*",
    "@hmt/security": "workspace:*",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
