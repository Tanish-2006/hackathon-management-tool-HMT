# HMT Docker - copy to .env and adjust for local dev
POSTGRES_DB=hmt
POSTGRES_USER=hmt
POSTGRES_PASSWORD=hmt_dev_password_change_in_prod
NEO4J_AUTH=neo4j/hmt_neo4j_password
REDIS_PASSWORD=hmt_redis_password
DATABASE_URL=postgresql://hmt:hmt_dev_password_change_in_prod@localhost:5432/hmt?schema=public
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hmt_neo4j_password
REDIS_URL=redis://:hmt_redis_password@localhost:6379
