{$SITE_ADDRESS::80} {
	handle /api/v1/* {
		reverse_proxy participant-api:3000 {
			flush_interval -1
		}
	}

	handle /organizer/api/* {
		uri strip_prefix /organizer
		reverse_proxy organizer-api:3002
	}

	handle /docs* {
		respond 404
	}

	handle {
		root * /srv
		encode gzip zstd
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
