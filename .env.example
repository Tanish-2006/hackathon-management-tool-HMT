# HMT Environment - copy to .env and fill secrets (never commit .env)
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (Docker default on 5433 to avoid host conflict) ---
DATABASE_URL=postgresql://hmt:hmt_dev_password_change_in_prod@localhost:5433/hmt?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hmt_neo4j_password
NEO4J_DATABASE=neo4j

# --- Redis (password included in URL) ---
REDIS_URL=redis://:hmt_redis_password@localhost:6379
REDIS_PREFIX=hmt:

# --- JWT (generate with: openssl rand -base64 48 ; min 32 chars) ---
# IMPORTANT: Use different secrets for access and refresh, rotate regularly
JWT_ACCESS_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars_access
JWT_REFRESH_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars_refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- App Ports (canonical dev: participant :3000, organizer :3002, frontend :5173; :3001 legacy, do not use) ---
PARTICIPANT_API_PORT=3000
ORGANIZER_API_PORT=3002

# --- CORS (comma-separated allowlist) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# --- Organizer → Participant sync (push + shared secret) ---
# Organizer pushes HackathonPublished events to the participant read-model.
# Empty SYNC_SHARED_SECRET uses a well-known DEV default outside production,
# so local development syncs with zero configuration. PRODUCTION MUST set a
# real secret (openssl rand -base64 32) identically on BOTH APIs — otherwise
# push is skipped and pull is rejected (fail-closed).
# Existing published hackathons recover without recreation via participant
# POST /sync/pull (Discover auto-pulls once + "Sync from organizer" button).
PARTICIPANT_API_URL=http://localhost:3000/api/v1
ORGANIZER_API_URL=http://localhost:3002/api/v1
SYNC_SHARED_SECRET=

# --- AI Gateway (provider-independent) ---
# mock = deterministic, no API key needed (CI/tests)
# external = OpenAI-compatible (OpenAI, Anthropic compat, self-hosted)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1

# --- GitHub Integration (READ-ONLY) ---
# mock = deterministic, no OAuth needed (CI/tests) — MockGitHubProvider
# real GitHub OAuth requires GITHUB_CLIENT_ID etc from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/callback
GITHUB_SCOPES=repo read:user

# --- Credential Encryption (AES-256-GCM, 32 bytes base64) ---
# Required for GitHub token encryption at rest. Generate: openssl rand -base64 32
# In production, inject via Vault/KMS env (see docs/security/ENCRYPTION.md)
# Fallback dev key is used if not set (never for production)
GITHUB_TOKEN_ENCRYPTION_KEY=
# Alternative aliases: ENCRYPTION_KEY, CREDENTIAL_ENCRYPTION_KEY
